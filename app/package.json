{
  "name": "minicajero",
  "module": "index.ts",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "bun --hot run index.ts",
    "start": "bun run index.ts",
    "build": "bun scripts/build.ts windows",
    "build:linux": "bun scripts/build.ts linux",
    "build:mac": "bun scripts/build.ts mac",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "icon": "bun scripts/generate-icon.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check-rules": "bun scripts/check-rules/index.ts",
    "verify": "tsc --noEmit && biome check . && bun scripts/check-rules/index.ts && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "^1.4.4",
    "oxc-parser": "0.159.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "bootstrap": "^5.3.8"
  }
}
